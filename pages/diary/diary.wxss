@import "../index/index.wxss";

.diary-hero-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 24rpx 26rpx;
  border-radius: 28rpx;
}

.diary-hero-card .hero-text {
  margin-bottom: 0;
}

.diary-hero-card .hero-title {
  margin-bottom: 4rpx;
  font-size: 38rpx;
  line-height: 1.2;
}

.diary-hero-card .hero-desc {
  font-size: 23rpx;
  line-height: 1.45;
}

.diary-new-btn {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  margin-top: 0;
  width: 150rpx;
  min-width: 150rpx;
  min-height: 64rpx;
  padding: 0;
  font-size: 24rpx;
  line-height: 64rpx;
  box-shadow: 0 12rpx 24rpx rgba(255, 179, 158, 0.26);
}

.diary-editor-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.diary-editor-cancel,
.diary-editor-save {
  flex: 1;
}

.diary-editor-panel {
  border-color: rgba(255, 221, 206, 0.98);
  background:
    radial-gradient(circle at top right, rgba(255, 233, 224, 0.9) 0%, rgba(255, 233, 224, 0) 34%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 246, 241, 0.96) 100%);
}

.diary-textarea {
  min-height: 360rpx;
  line-height: 1.7;
}

.diary-card {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(244, 224, 215, 0.9);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.78);
}

.diary-card-main {
  flex: 1;
  min-width: 0;
}

.diary-card-date,
.diary-card-preview,
.diary-card-meta {
  display: block;
}

.diary-card-date {
  margin-bottom: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #e58a67;
}

.diary-card-preview {
  white-space: pre-wrap;
  font-size: 24rpx;
  line-height: 1.7;
  color: #708095;
}

.diary-card-meta {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #9aa7b7;
}

.diary-card-actions {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  gap: 12rpx;
  margin-left: 18rpx;
}

.diary-card-btn {
  min-height: 58rpx;
  margin-left: 0;
  padding: 0 22rpx;
  font-size: 23rpx;
}

.diary-delete-btn {
  color: #cf5f36;
}
