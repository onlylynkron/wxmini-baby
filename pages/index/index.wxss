  margin-top: 18rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 30rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(250, 247, 244, 0.95) 100%);
  box-shadow: 0 12rpx 24rpx rgba(227, 205, 195, 0.14);
}

.growth-chart-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #344052;
}

.growth-chart {
  position: relative;
  height: 180rpx;
  border-radius: 24rpx;
  background:
    linear-gradient(180deg, rgba(255, 250, 246, 0.98) 0%, rgba(248, 250, 255, 0.96) 100%);
  overflow: hidden;
}

.growth-chart-plot {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  left: 20rpx;
}

.growth-chart-line {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.growth-chart::before,
.growth-chart::after {
  content: "";
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  border-top: 1rpx dashed rgba(206, 213, 224, 0.8);
}

.growth-chart::before {
  top: 60rpx;
}

.growth-chart::after {
  top: 120rpx;
}

.growth-point {
  position: absolute;
  z-index: 2;
  opacity: 0;
  transform: translate(-50%, -50%);
}

.growth-point-animated {
  animation: growthPointReveal 0.48s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

.growth-point-dot {
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  box-shadow: 0 8rpx 18rpx rgba(176, 191, 219, 0.2);
}

.growth-point-height {
  background: #7a9cf0;
}

.growth-point-weight {
  background: #ef9b78;
}

.growth-point-head {
  background: #8bc59e;
}

.growth-point-value {
  position: absolute;
  max-width: 120rpx;
  white-space: nowrap;
  font-size: 20rpx;
  font-weight: 700;
  color: #657487;
}

.growth-point-value-top {
  left: 50%;
  bottom: 22rpx;
  transform: translateX(-50%);
}

.growth-point-value-bottom {
  left: 50%;
  top: 22rpx;
  transform: translateX(-50%);
}

.growth-point-value-left {
  right: 22rpx;
  top: 50%;
  transform: translateY(-50%);
}

.growth-point-value-right {
  left: 22rpx;
  top: 50%;
  transform: translateY(-50%);
}

@keyframes growthPointReveal {
  from {
    opacity: 0;
    transform: translate(-50%, -44%) scale(0.86);
  }

  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

