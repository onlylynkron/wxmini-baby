  border-radius: 999rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.record-action-icon {
  width: 23rpx;
  height: 23rpx;
}

.record-icon-edit {
  border: 1rpx solid rgba(182, 204, 244, 0.92);
  background: rgba(241, 247, 255, 0.7);
  box-shadow: none;
}

.record-icon-delete {
  border: 1rpx solid rgba(247, 210, 195, 0.94);
  background: rgba(255, 245, 240, 0.7);
  box-shadow: none;
}

@keyframes popupShellFadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes popupPanelSlideIn {
  from {
    opacity: 0;
    transform: translateY(32rpx) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
