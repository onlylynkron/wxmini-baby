.page {
  position: relative;
  padding: 28rpx 24rpx 56rpx;
}

.page-editing {
  height: 100vh;
  overflow: hidden;
}

.hero-card,
.panel {
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 42rpx;
  box-shadow: 0 22rpx 54rpx rgba(228, 198, 185, 0.26);
  backdrop-filter: blur(18rpx);
}

.hero-card {
  margin-bottom: 26rpx;
  padding: 38rpx 34rpx;
  background:
    radial-gradient(circle at top left, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0) 36%),
    linear-gradient(145deg, rgba(255, 242, 232, 0.98) 0%, rgba(255, 249, 244, 0.94) 46%, rgba(244, 247, 255, 0.96) 100%);
}

.hero-text {
  margin-bottom: 30rpx;
}

.hero-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #2f3448;
}

.hero-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  color: #708095;
}

.profile-summary-card,
.manage-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.97) 0%, rgba(255, 248, 244, 0.94) 100%);
  box-shadow: 0 12rpx 28rpx rgba(224, 196, 182, 0.16);
}

.profile-summary-main,
.member-main {
  flex: 1;
  min-width: 0;
}

.profile-summary-name {
  display: block;
  margin-bottom: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #344052;
}

.profile-summary-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
  color: #7b8a9d;
}

.profile-toggle-btn {
  margin-left: 20rpx;
}

.info-card,
.invite-card {
  margin-bottom: 24rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 250, 246, 0.92) 100%);
  box-shadow: 0 12rpx 28rpx rgba(224, 196, 182, 0.16);
}

.info-card-title,
.info-card-desc,
.invite-label,
.invite-code,
.invite-desc {
  display: block;
}

.invite-label {
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: #90a0b4;
}

.invite-code {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #394152;
}

.info-card-desc,
.helper-text {
  font-size: 24rpx;
  line-height: 1.8;
  color: #708095;
}

.info-card-title {
  margin-bottom: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #344052;
}

.hero-stats,
.mini-stats {
  display: flex;
  flex-wrap: wrap;
  margin-right: -16rpx;
  margin-bottom: -16rpx;
}

.latest-status-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
  margin-right: -16rpx;
  margin-bottom: -16rpx;
}

.latest-status-card {
  position: relative;
  flex: 1;
  min-width: 280rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 30rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(252, 247, 244, 0.95) 100%);
  box-shadow: 0 14rpx 28rpx rgba(226, 205, 196, 0.14);
  transition: background 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.latest-status-feeding {
  background: linear-gradient(180deg, rgba(255, 248, 243, 0.98) 0%, rgba(255, 241, 234, 0.96) 100%);
}

.latest-status-diaper {
  background: linear-gradient(180deg, rgba(248, 250, 255, 0.98) 0%, rgba(239, 245, 255, 0.96) 100%);
}

.latest-status-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 40rpx;
  margin-bottom: 14rpx;
}

.latest-status-label,
.latest-status-time,
.latest-status-detail,
.latest-status-relative {
  display: block;
}

.latest-status-label {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 40rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #8391a2;
}

.latest-status-time {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.45;
  color: #334052;
}

.latest-status-detail {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #677789;
}

.latest-status-relative {
  font-size: 24rpx;
  line-height: 1.6;
  color: #7f8fa3;
}

.latest-status-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  max-width: 160rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  min-height: 40rpx;
}

.latest-status-badge-text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.latest-status-badge-fresh {
  background: rgba(147, 214, 180, 0.26);
  color: #2e8a61;
}

.latest-status-badge-recent {
  background: rgba(189, 223, 201, 0.32);
  color: #5a8b73;
}

.latest-status-badge-warning {
  background: rgba(255, 196, 132, 0.28);
  color: #b26b20;
}

.latest-status-badge-alert {
  background: rgba(234, 95, 95, 0.18);
  color: #c64141;
}

.latest-status-badge-future {
  background: rgba(171, 151, 255, 0.2);
  color: #7555c5;
}

.latest-status-tone-empty {
  border-color: rgba(228, 234, 243, 0.96);
  background: linear-gradient(180deg, rgba(249, 251, 255, 0.99) 0%, rgba(243, 247, 252, 0.96) 100%);
  box-shadow: 0 12rpx 24rpx rgba(198, 209, 227, 0.12);
}

.latest-status-tone-empty .latest-status-time {
  color: #5e6e83;
}

.latest-status-tone-empty .latest-status-detail,
.latest-status-tone-empty .latest-status-relative {
  color: #97a5b6;
}

.latest-status-tone-fresh {
  border-color: rgba(155, 218, 186, 0.72);
  background: linear-gradient(180deg, rgba(244, 255, 248, 0.99) 0%, rgba(236, 251, 242, 0.97) 100%);
  box-shadow: 0 16rpx 30rpx rgba(114, 188, 145, 0.16);
}

.latest-status-tone-fresh .latest-status-time {
  color: #2d6c55;
}

.latest-status-tone-fresh .latest-status-detail,
.latest-status-tone-fresh .latest-status-relative {
  color: #2f8a63;
}

.latest-status-tone-recent {
  border-color: rgba(190, 224, 201, 0.76);
  background: linear-gradient(180deg, rgba(248, 255, 250, 0.99) 0%, rgba(240, 250, 244, 0.97) 100%);
  box-shadow: 0 16rpx 30rpx rgba(144, 193, 164, 0.14);
}

.latest-status-tone-recent .latest-status-label {
  color: #7f998c;
}

.latest-status-tone-recent .latest-status-time {
  color: #4e8067;
}

.latest-status-tone-recent .latest-status-detail,
.latest-status-tone-recent .latest-status-relative {
  color: #6c937f;
}

.latest-status-tone-warning {
  border-color: rgba(255, 194, 127, 0.76);
  background: linear-gradient(180deg, rgba(255, 249, 239, 0.99) 0%, rgba(255, 241, 226, 0.97) 100%);
  box-shadow: 0 18rpx 32rpx rgba(241, 180, 106, 0.18);
}

.latest-status-tone-warning .latest-status-time {
  color: #9c5f1b;
}

.latest-status-tone-warning .latest-status-detail,
.latest-status-tone-warning .latest-status-relative {
  color: #bb731f;
}

.latest-status-tone-alert {
  border-color: rgba(227, 95, 95, 0.82);
  background: linear-gradient(180deg, rgba(255, 237, 237, 0.99) 0%, rgba(255, 224, 224, 0.98) 100%);
  box-shadow: 0 22rpx 40rpx rgba(220, 86, 86, 0.24);
}

.latest-status-tone-alert .latest-status-label {
  color: #a34f4f;
}

.latest-status-tone-alert .latest-status-time {
  color: #c33b3b;
  font-size: 32rpx;
}

.latest-status-tone-alert .latest-status-detail,
.latest-status-tone-alert .latest-status-relative {
  color: #cf4a4a;
  font-weight: 700;
}

.latest-status-tone-future {
  border-color: rgba(171, 151, 255, 0.5);
  background: linear-gradient(180deg, rgba(247, 243, 255, 0.99) 0%, rgba(240, 233, 255, 0.97) 100%);
}

.latest-status-tone-future .latest-status-time,
.latest-status-tone-future .latest-status-relative {
  color: #7658bf;
}

.stat-card,
.mini-stat {
  flex: 1;
  min-width: 180rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 30rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 251, 247, 0.92) 100%);
  box-shadow: 0 14rpx 28rpx rgba(229, 205, 193, 0.14);
}

.mini-stat {
  background: linear-gradient(180deg, rgba(255, 250, 246, 0.96) 0%, rgba(247, 249, 253, 0.94) 100%);
}

.stat-label,
.stat-value,
.mini-stat-label,
.mini-stat-value {
  display: block;
}

.stat-label,
.mini-stat-label {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #8391a2;
}

.stat-value,
.mini-stat-value {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  color: #303949;
}

.panel {
  margin-bottom: 26rpx;
  padding: 30rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(255, 250, 246, 0.9) 100%);
}

.record-entry-panel {
  border-color: rgba(255, 221, 206, 0.98);
  box-shadow: 0 24rpx 58rpx rgba(255, 183, 153, 0.24);
  background:
    radial-gradient(circle at top right, rgba(255, 233, 224, 0.9) 0%, rgba(255, 233, 224, 0) 34%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 246, 241, 0.96) 100%);
}

.record-entry-shell {
  position: relative;
  z-index: 1;
}

.record-popup-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  background: rgba(70, 57, 52, 0.26);
  backdrop-filter: blur(12rpx);
}

.record-entry-shell-popup {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
  padding: 88rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  animation: popupShellFadeIn 0.18s ease;
}

.record-entry-panel-popup {
  margin-bottom: 0;
  border-color: rgba(255, 228, 216, 0.98);
  box-shadow: 0 30rpx 72rpx rgba(133, 93, 75, 0.2);
  background:
    radial-gradient(circle at top right, rgba(255, 234, 225, 0.94) 0%, rgba(255, 234, 225, 0) 34%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.99) 0%, rgba(255, 247, 242, 0.98) 100%);
  animation: popupPanelSlideIn 0.22s ease;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0.8rpx;
  color: #334052;
}

.section-note {
  font-size: 24rpx;
  color: #93a1b3;
}

.field,
.field-row {
  margin-bottom: 24rpx;
}

.field-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.field-row .field {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.field-row .field:first-child {
  margin-right: 16rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  padding-left: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #617083;
}

.edit-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(255, 201, 183, 0.95);
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(255, 244, 239, 0.98) 0%, rgba(255, 236, 231, 0.96) 100%);
  box-shadow: 0 12rpx 24rpx rgba(235, 184, 164, 0.16);
}

.edit-banner-main {
  flex: 1;
  min-width: 0;
}

.edit-banner-title,
.edit-banner-desc {
  display: block;
}

.edit-banner-title {
  margin-bottom: 6rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #b65f3c;
}

.edit-banner-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: #7b6b63;
}

.edit-banner-btn {
  margin-left: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #b65f3c;
}

.picker-field,
.input-field,
.textarea-field {
  display: block;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(244, 224, 215, 0.95);
  border-radius: 30rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(250, 246, 243, 0.96) 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.92), 0 10rpx 24rpx rgba(234, 215, 206, 0.14);
  font-size: 28rpx;
  color: #2d3646;
}

.picker-field {
  min-height: 96rpx;
  line-height: 46rpx;
}

.input-field {
  height: 96rpx;
  padding: 0 28rpx;
  line-height: 94rpx;
}

.textarea-field {
  height: 190rpx;
  line-height: 1.7;
}

.picker-placeholder {
  color: #a0acbb;
}

.scroll-select {
  width: 100%;
  white-space: nowrap;
}

.scroll-track {
  display: inline-flex;
  align-items: stretch;
  padding: 2rpx 4rpx 6rpx;
}

.option-card,
.pill-option {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  border: 1rpx solid rgba(239, 224, 218, 0.95);
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(248, 243, 240, 0.92) 100%);
  box-shadow: 0 10rpx 22rpx rgba(230, 208, 198, 0.14);
  color: #617083;
}

.option-card {
  width: 250rpx;
  min-height: 100rpx;
  padding: 20rpx 22rpx;
}

.option-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
}

.option-card-active,
.pill-option-active {
  border-color: rgba(255, 178, 138, 0.6);
  background: linear-gradient(135deg, #ffccb3 0%, #ffb7b5 48%, #ffcbbd 100%);
  color: #6a3523;
  box-shadow: 0 14rpx 28rpx rgba(255, 176, 150, 0.28);
}

.pill-option {
  min-width: 172rpx;
  padding: 20rpx 26rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.pill-option-filter {
  min-width: 144rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
}

.pill-option-compact {
  min-width: 114rpx;
}

.compact-scroll .scroll-track {
  min-height: 98rpx;
}

.poop-grid {
  display: flex;
  flex-wrap: wrap;
  margin-right: -16rpx;
  margin-bottom: -16rpx;
}

.diaper-helper-text {
  margin-top: -6rpx;
  margin-bottom: 18rpx;
  padding-left: 8rpx;
}

.poop-card {
  width: 188rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  padding: 18rpx 12rpx;
  border: 1rpx solid rgba(242, 226, 219, 0.95);
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.97) 0%, rgba(250, 246, 243, 0.95) 100%);
  box-shadow: 0 12rpx 26rpx rgba(232, 212, 201, 0.14);
  text-align: center;
}

.poop-card-active {
  background: linear-gradient(180deg, rgba(255, 243, 236, 1) 0%, rgba(255, 234, 226, 0.98) 100%);
  box-shadow: inset 0 0 0 2rpx #ffab86, 0 14rpx 28rpx rgba(255, 183, 153, 0.2);
}

.poop-image {
  width: 98rpx;
  height: 98rpx;
  margin: 0 auto 12rpx;
}

.poop-name {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #4f5d70;
}

.pill-option-shape {
  min-width: 160rpx;
}

.diaper-rash-row {
  gap: 16rpx;
}

.diaper-rash-row .diaper-rash-option {
  min-width: 0;
  flex: 1;
  margin-right: 0;
}

.primary-btn,
.secondary-btn,
.ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  font-weight: 700;
  letter-spacing: 0.6rpx;
}

.primary-btn {
  margin-top: 10rpx;
  background: linear-gradient(135deg, #ffc8b0 0%, #ffaaa6 52%, #ffbca6 100%);
  box-shadow: 0 18rpx 34rpx rgba(255, 179, 158, 0.34);
  color: #6c382a;
  font-size: 30rpx;
}

.secondary-btn {
  margin-top: 16rpx;
  border: 1rpx solid rgba(241, 223, 216, 0.96);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(247, 242, 239, 0.94) 100%);
  box-shadow: 0 12rpx 26rpx rgba(226, 207, 198, 0.16);
  color: #5f6d80;
  font-size: 28rpx;
}

.ghost-btn {
  margin: 0;
  min-height: 72rpx;
  padding: 0 28rpx;
  border: 1rpx solid rgba(239, 224, 217, 0.96);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(248, 244, 241, 0.94) 100%);
  box-shadow: 0 10rpx 22rpx rgba(226, 208, 200, 0.12);
  color: #667486;
}

.primary-btn[disabled],
.secondary-btn[disabled],
.ghost-btn[disabled] {
  box-shadow: none;
  color: #acb5c2;
}

.primary-btn::after,
.secondary-btn::after,
.ghost-btn::after {
  border: none;
}

.invite-copy-btn {
  margin-top: 20rpx;
}

.manage-card {
  display: block;
}

.collaboration-summary-card {
  margin-bottom: 0;
}

.manage-card-title,
.manage-card-desc,
.member-name,
.member-desc {
  display: block;
}

.manage-card-title {
  margin-bottom: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #344052;
}

.manage-card-desc {
  font-size: 24rpx;
  line-height: 1.8;
  color: #708095;
}

.manage-share-btn {
  margin-top: 22rpx;
}

.member-list {
  margin-top: 8rpx;
}

.member-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(250, 247, 244, 0.95) 100%);
  box-shadow: 0 12rpx 24rpx rgba(227, 205, 195, 0.14);
}

.member-item:last-child {
  margin-bottom: 0;
}

.member-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.member-name {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #344052;
}

.member-role-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
}

.member-role-text {
  font-size: 22rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.member-role-owner {
  background: rgba(255, 188, 166, 0.28);
  color: #b15b37;
}

.member-role-manager {
  background: rgba(199, 209, 226, 0.3);
  color: #657487;
}

.member-desc {
  font-size: 24rpx;
  line-height: 1.7;
  color: #8391a2;
}

.member-remove-btn {
  margin-left: 20rpx;
  background: linear-gradient(180deg, rgba(255, 244, 239, 0.98) 0%, rgba(255, 235, 228, 0.96) 100%);
  color: #cf5f36;
}

.member-leave-btn {
  border-color: rgba(255, 224, 217, 0.98);
  background: linear-gradient(180deg, rgba(255, 245, 241, 0.98) 0%, rgba(255, 237, 231, 0.96) 100%);
  color: #c6603f;
}

.filter-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.filter-reset-btn {
  flex-shrink: 0;
}

.filter-tip {
  flex: 1;
  min-width: 220rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8391a2;
}

.record-filter-box {
  margin-bottom: 24rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(255, 243, 236, 0.96);
  border-radius: 32rpx;
  background: linear-gradient(180deg, rgba(255, 251, 248, 0.98) 0%, rgba(248, 250, 255, 0.95) 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.92), 0 12rpx 26rpx rgba(227, 208, 197, 0.12);
}

.record-filter-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.record-filter-toggle-main,
.record-filter-toggle-side {
  min-width: 0;
}

.record-filter-toggle-main {
  flex: 1;
}

.record-filter-toggle-side {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 12rpx;
}

.record-filter-toggle-title,
.record-filter-toggle-desc,
.record-filter-toggle-tag,
.record-filter-toggle-action {
  display: block;
}

.record-filter-toggle-title {
  margin-bottom: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #344052;
}

.record-filter-toggle-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: #8391a2;
}

.record-filter-toggle-tag {
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 197, 173, 0.28);
  color: #b66743;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.record-filter-toggle-action {
  font-size: 24rpx;
  font-weight: 700;
  color: #667486;
}

.record-filter-collapsed-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
}

.record-filter-content {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(244, 229, 221, 0.9);
}

.record-filter-field:last-of-type {
  margin-bottom: 18rpx;
}

.empty-state {
  padding: 50rpx 24rpx 28rpx;
  text-align: center;
}

.history-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 0;
  margin-bottom: 20rpx;
}

.history-clear-btn {
  background: linear-gradient(180deg, rgba(255, 243, 239, 0.98) 0%, rgba(255, 236, 230, 0.96) 100%);
  color: #cf5f36;
}

.history-clear-btn[disabled] {
  background: linear-gradient(180deg, rgba(245, 246, 249, 0.98) 0%, rgba(239, 242, 246, 0.96) 100%);
  color: #a1acbc;
}

.empty-title,
.empty-desc {
  display: block;
}

.empty-title {
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #334052;
}

.empty-desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: #8794a6;
}

.record-card {
  margin-bottom: 14rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(250, 247, 244, 0.95) 100%);
  box-shadow: 0 14rpx 28rpx rgba(229, 205, 193, 0.16);
}

.record-top {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.record-badge {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.record-badge-feeding {
  background: rgba(255, 184, 148, 0.24);
  color: #b55e34;
}

.record-badge-diaper {
  background: rgba(141, 177, 255, 0.22);
  color: #4469bc;
}

.record-badge-sleep {
  background: rgba(154, 221, 205, 0.28);
  color: #2a7d6c;
}

.record-badge-medicine {
  background: rgba(213, 183, 255, 0.28);
  color: #8454bf;
}

.record-badge-temperature {
  background: rgba(255, 178, 188, 0.28);
  color: #c65469;
}

.record-badge-growth {
  background: rgba(179, 191, 255, 0.26);
  color: #495fc1;
}

.record-badge-default {
  background: rgba(197, 205, 216, 0.3);
  color: #5b6879;
}

.record-time {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 23rpx;
  line-height: 1.4;
  text-align: right;
  color: #94a1b2;
}

.record-main {
  flex: 1;
  min-width: 0;
  padding-right: 4rpx;
}

.record-body {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.record-title,
.record-subtitle,
.record-note {
  display: block;
}

.record-title {
  margin-bottom: 6rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.42;
  color: #324051;
}

.record-subtitle,
.record-note {
  font-size: 24rpx;
  line-height: 1.5;
  color: #718093;
}

.record-note {
  margin-top: 4rpx;
}

.record-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  align-self: flex-start;
  flex-shrink: 0;
  gap: 12rpx;
  min-width: 132rpx;
  padding-top: 2rpx;
}

.record-icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  min-height: 60rpx;
  padding: 0;
  border-radius: 999rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.record-action-icon {
  width: 26rpx;
  height: 26rpx;
}

.record-icon-edit {
  border: 1rpx solid rgba(182, 204, 244, 0.92);
  background: linear-gradient(180deg, rgba(241, 247, 255, 0.98) 0%, rgba(232, 241, 255, 0.96) 100%);
  box-shadow: 0 8rpx 18rpx rgba(177, 197, 233, 0.18);
}

.record-icon-delete {
  border: 1rpx solid rgba(247, 210, 195, 0.94);
  background: linear-gradient(180deg, rgba(255, 245, 240, 0.98) 0%, rgba(255, 237, 230, 0.96) 100%);
  box-shadow: 0 8rpx 18rpx rgba(232, 188, 171, 0.18);
}

@keyframes popupShellFadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes popupPanelSlideIn {
  from {
    opacity: 0;
    transform: translateY(32rpx) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}
