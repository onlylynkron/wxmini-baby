.page {
  position: relative;
  padding: 28rpx 24rpx 56rpx;
}

.page-editing {
  height: 100vh;
  overflow: hidden;
}

.hero-card,
.panel {
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 42rpx;
  box-shadow: 0 22rpx 54rpx rgba(228, 198, 185, 0.26);
  backdrop-filter: blur(18rpx);
}

.hero-card {
  margin-bottom: 26rpx;
  padding: 38rpx 34rpx;
  background:
    radial-gradient(circle at top left, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0) 36%),
    linear-gradient(145deg, rgba(255, 242, 232, 0.98) 0%, rgba(255, 249, 244, 0.94) 46%, rgba(244, 247, 255, 0.96) 100%);
}

.hero-text {
  margin-bottom: 30rpx;
}

.hero-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.hero-title {
  display: block;
  flex: 1;
  min-width: 0;
  font-size: 46rpx;
  font-weight: 700;
  color: #2f3448;
}

.hero-vitamin-warning {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 226, 226, 0.94);
  font-size: 22rpx;
  font-weight: 700;
  color: #d83b3b;
}

.hero-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  color: #708095;
}

.profile-summary-card,
.manage-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.97) 0%, rgba(255, 248, 244, 0.94) 100%);
  box-shadow: 0 12rpx 28rpx rgba(224, 196, 182, 0.16);
}

.profile-summary-main,
.member-main {
  flex: 1;
  min-width: 0;
}

.profile-summary-name {
  display: block;
  margin-bottom: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #344052;
}

.profile-summary-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
  color: #7b8a9d;
}

.profile-toggle-btn {
  margin-left: 20rpx;
}

.info-card,
.invite-card {
  margin-bottom: 24rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 250, 246, 0.92) 100%);
  box-shadow: 0 12rpx 28rpx rgba(224, 196, 182, 0.16);
}

.info-card-title,
.info-card-desc,
.invite-label,
.invite-code,
.invite-desc {
  display: block;
}

.invite-label {
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: #90a0b4;
}

.invite-code {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #394152;
}

.info-card-desc,
.helper-text {
  font-size: 24rpx;
  line-height: 1.8;
  color: #708095;
}

.info-card-title {
  margin-bottom: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #344052;
}

.hero-stats,
.mini-stats {
  display: flex;
  flex-wrap: wrap;
  margin-right: -16rpx;
  margin-bottom: -16rpx;
}

.hero-stats {
  flex-wrap: nowrap;
  margin-right: 0;
  margin-bottom: 0;
  gap: 12rpx;
}

.latest-status-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
  margin-right: -16rpx;
  margin-bottom: -16rpx;
}

.feeding-chart-card {
  margin-top: 22rpx;
  padding: 24rpx 24rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 30rpx;
  background: linear-gradient(180deg, rgba(255, 252, 248, 0.98) 0%, rgba(249, 250, 255, 0.95) 100%);
  box-shadow: 0 14rpx 28rpx rgba(224, 206, 196, 0.14);
}

.feeding-chart-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.feeding-chart-main {
  min-width: 0;
}

.feeding-chart-title,
.feeding-chart-desc,
.feeding-chart-value,
.feeding-chart-day {
  display: block;
}

.feeding-chart-title {
  margin-bottom: 6rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #344052;
}

.feeding-chart-desc {
  font-size: 22rpx;
  line-height: 1.6;
  color: #8391a2;
}

.feeding-chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 10rpx;
  height: 220rpx;
}

.feeding-chart-item {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}

.feeding-chart-value {
  margin-bottom: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #7d8b9d;
}

.feeding-chart-bar-shell {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 100%;
  height: 132rpx;
  padding: 0 6rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, rgba(246, 247, 251, 0.96) 0%, rgba(240, 243, 248, 0.94) 100%);
}

.feeding-chart-bar {
  width: 100%;
  min-height: 8rpx;
  border-radius: 18rpx 18rpx 12rpx 12rpx;
  background: linear-gradient(180deg, #ffc8b0 0%, #ffaaa6 52%, #ffbca6 100%);
  box-shadow: 0 10rpx 18rpx rgba(255, 179, 158, 0.24);
}

.feeding-chart-bar-today {
  background: linear-gradient(180deg, #ffb999 0%, #ff8f8f 52%, #ffad8d 100%);
  box-shadow: 0 12rpx 20rpx rgba(246, 146, 126, 0.28);
}

.feeding-chart-day {
  margin-top: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #8b98a9;
}

.feeding-chart-day-today {
  color: #cf6b48;
}

.latest-status-card {
  position: relative;
  flex: 1;
  min-width: 280rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  padding: 20rpx 20rpx 18rpx;
  border: 1rpx solid rgba(244, 236, 230, 0.76);
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(252, 247, 244, 0.95) 100%);
  box-shadow: 0 12rpx 24rpx rgba(226, 205, 196, 0.1);
  transition: background 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.latest-status-feeding {
  background: linear-gradient(180deg, rgba(255, 250, 246, 0.98) 0%, rgba(255, 244, 239, 0.96) 100%);
}

.latest-status-diaper {
  background: linear-gradient(180deg, rgba(248, 251, 255, 0.98) 0%, rgba(242, 247, 255, 0.96) 100%);
}

.latest-status-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 34rpx;
  margin-bottom: 10rpx;
}

.latest-status-label,
.latest-status-time,
.latest-status-summary {
  display: block;
}

.latest-status-label {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 34rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #93a0ae;
}

.latest-status-time {
  margin-bottom: 6rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #4a586d;
}

.latest-status-summary {
  font-size: 22rpx;
  line-height: 1.45;
  color: #8190a1;
}

.latest-status-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  max-width: 138rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  min-height: 34rpx;
}

.latest-status-badge-text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 17rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.latest-status-badge-fresh {
  background: rgba(181, 219, 197, 0.26);
  color: #5d8f75;
}

.latest-status-badge-recent {
  background: rgba(199, 223, 208, 0.3);
  color: #6e8d7d;
}

.latest-status-badge-warning {
  background: rgba(241, 210, 165, 0.28);
  color: #b08a57;
}

.latest-status-badge-alert {
  background: rgba(236, 179, 179, 0.2);
  color: #bf7d7d;
}

.latest-status-badge-future {
  background: rgba(171, 151, 255, 0.2);
  color: #7555c5;
}

.latest-status-tone-empty {
  border-color: rgba(235, 238, 242, 0.82);
  background: linear-gradient(180deg, rgba(251, 252, 255, 0.99) 0%, rgba(246, 248, 251, 0.96) 100%);
  box-shadow: 0 10rpx 20rpx rgba(204, 212, 223, 0.08);
}

.latest-status-tone-empty .latest-status-time {
  color: #738398;
}

.latest-status-tone-empty .latest-status-summary {
  color: #a4afbc;
}

.latest-status-tone-fresh {
  border-color: rgba(196, 224, 206, 0.6);
  background: linear-gradient(180deg, rgba(247, 253, 249, 0.99) 0%, rgba(239, 248, 243, 0.97) 100%);
  box-shadow: 0 12rpx 24rpx rgba(162, 201, 179, 0.1);
}

.latest-status-tone-fresh .latest-status-time {
  color: #678972;
}

.latest-status-tone-fresh .latest-status-summary {
  color: #7a9686;
}

.latest-status-tone-recent {
  border-color: rgba(202, 225, 210, 0.6);
  background: linear-gradient(180deg, rgba(249, 254, 251, 0.99) 0%, rgba(242, 249, 245, 0.97) 100%);
  box-shadow: 0 12rpx 24rpx rgba(171, 200, 181, 0.1);
}

.latest-status-tone-recent .latest-status-label {
  color: #98a8a0;
}

.latest-status-tone-recent .latest-status-time {
  color: #6f8b7d;
}

.latest-status-tone-recent .latest-status-summary {
  color: #83988d;
}

.latest-status-tone-warning {
  border-color: rgba(235, 210, 177, 0.64);
  background: linear-gradient(180deg, rgba(255, 251, 243, 0.99) 0%, rgba(251, 244, 232, 0.97) 100%);
  box-shadow: 0 12rpx 24rpx rgba(219, 196, 157, 0.1);
}

.latest-status-tone-warning .latest-status-time {
  color: #a1865f;
}

.latest-status-tone-warning .latest-status-summary {
  color: #b19672;
}

.latest-status-tone-alert {
  border-color: rgba(227, 95, 95, 0.82);
  background: linear-gradient(180deg, rgba(255, 237, 237, 0.99) 0%, rgba(255, 224, 224, 0.98) 100%);
  box-shadow: 0 22rpx 40rpx rgba(220, 86, 86, 0.24);
}

.latest-status-tone-alert .latest-status-label {
  color: #b48a8a;
}

.latest-status-tone-alert .latest-status-time {
  color: #b57f7f;
  font-size: 28rpx;
}

.latest-status-tone-alert .latest-status-summary {
  color: #c09393;
  font-weight: 700;
}

.latest-status-tone-future {
  border-color: rgba(171, 151, 255, 0.5);
  background: linear-gradient(180deg, rgba(247, 243, 255, 0.99) 0%, rgba(240, 233, 255, 0.97) 100%);
}

.latest-status-tone-future .latest-status-time,
.latest-status-tone-future .latest-status-summary {
  color: #7658bf;
}

.stat-card,
.mini-stat {
  flex: 1;
  min-width: 180rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 30rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 251, 247, 0.92) 100%);
  box-shadow: 0 14rpx 28rpx rgba(229, 205, 193, 0.14);
}

.hero-stats .stat-card {
  min-width: 0;
  margin-right: 0;
  margin-bottom: 0;
  padding: 20rpx 14rpx;
  border-radius: 26rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 251, 247, 0.92) 100%);
  box-shadow: 0 14rpx 28rpx rgba(229, 205, 193, 0.14);
}

.mini-stat {
  background: linear-gradient(180deg, rgba(255, 250, 246, 0.96) 0%, rgba(247, 249, 253, 0.94) 100%);
}

.stat-label,
.stat-value,
.mini-stat-label,
.mini-stat-value {
  display: block;
}

.stat-label,
.mini-stat-label {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #8391a2;
}

.hero-stats .stat-label {
  margin-bottom: 6rpx;
  font-size: 22rpx;
}

.stat-value,
.mini-stat-value {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  color: #303949;
}

.hero-stats .stat-value {
  font-size: 24rpx;
  letter-spacing: 0;
  white-space: nowrap;
}

.panel {
  margin-bottom: 26rpx;
  padding: 30rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(255, 250, 246, 0.9) 100%);
}

.record-entry-panel {
  border-color: rgba(255, 221, 206, 0.98);
  box-shadow: 0 24rpx 58rpx rgba(255, 183, 153, 0.24);
  background:
    radial-gradient(circle at top right, rgba(255, 233, 224, 0.9) 0%, rgba(255, 233, 224, 0) 34%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 246, 241, 0.96) 100%);
  padding-top: 24rpx;
}

.record-entry-shell {
  position: relative;
  z-index: 1;
}

.record-popup-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  background: rgba(70, 57, 52, 0.26);
  backdrop-filter: blur(12rpx);
}

.record-entry-shell-popup {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
  padding: 88rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  animation: popupShellFadeIn 0.18s ease;
}

.record-entry-panel-popup {
  margin-bottom: 0;
  border-color: rgba(255, 228, 216, 0.98);
  box-shadow: 0 30rpx 72rpx rgba(133, 93, 75, 0.2);
  background:
    radial-gradient(circle at top right, rgba(255, 234, 225, 0.94) 0%, rgba(255, 234, 225, 0) 34%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.99) 0%, rgba(255, 247, 242, 0.98) 100%);
  animation: popupPanelSlideIn 0.22s ease;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.record-entry-panel .section-head {
  margin-bottom: 14rpx;
}

.record-entry-panel .section-title {
  font-size: 28rpx;
}

.record-entry-panel .field,
.record-entry-panel .field-row {
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0.8rpx;
  color: #334052;
}

.section-note {
  font-size: 24rpx;
  color: #93a1b3;
}

.field,
.field-row {
  margin-bottom: 24rpx;
}

.field-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.field-row-compact {
  gap: 14rpx;
}

.field-row .field {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.field-row .field:first-child {
  margin-right: 16rpx;
}

.field-row-compact .field:first-child {
  margin-right: 0;
}

.field-compact {
  margin-bottom: 0;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  padding-left: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #617083;
}

.field-label-compact {
  margin-bottom: 8rpx;
  font-size: 22rpx;
}

.record-entry-panel .field-label {
  margin-bottom: 10rpx;
  font-size: 23rpx;
}

.record-entry-panel .field-label-compact {
  margin-bottom: 6rpx;
  font-size: 20rpx;
}

.edit-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(255, 201, 183, 0.95);
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(255, 244, 239, 0.98) 0%, rgba(255, 236, 231, 0.96) 100%);
  box-shadow: 0 12rpx 24rpx rgba(235, 184, 164, 0.16);
}

.edit-banner-main {
  flex: 1;
  min-width: 0;
}

.edit-banner-title,
.edit-banner-desc {
  display: block;
}

.edit-banner-title {
  margin-bottom: 6rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #b65f3c;
}

.edit-banner-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: #7b6b63;
}

.edit-banner-btn {
  margin-left: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #b65f3c;
}

.picker-field,
.input-field,
.textarea-field {
  display: block;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(244, 224, 215, 0.95);
  border-radius: 30rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(250, 246, 243, 0.96) 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.92), 0 10rpx 24rpx rgba(234, 215, 206, 0.14);
  font-size: 28rpx;
  color: #2d3646;
}

.picker-field {
  min-height: 96rpx;
  line-height: 46rpx;
}

.picker-field-compact {
  min-height: 74rpx;
  padding: 15rpx 20rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  line-height: 40rpx;
}

.input-field {
  height: 96rpx;
  padding: 0 28rpx;
  line-height: 94rpx;
}

.record-entry-panel .input-field,
.record-entry-panel .picker-field {
  height: 84rpx;
  min-height: 84rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  line-height: 82rpx;
}

.record-entry-panel .picker-field-compact {
  height: auto;
  min-height: 74rpx;
  padding: 15rpx 20rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  line-height: 40rpx;
}

.textarea-field {
  height: 190rpx;
  line-height: 1.7;
}

.textarea-field-compact {
  height: 144rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.note-box {
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(244, 229, 221, 0.94);
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(255, 252, 249, 0.98) 0%, rgba(250, 246, 243, 0.95) 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.92), 0 10rpx 22rpx rgba(230, 210, 201, 0.1);
}

.note-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 24rpx;
}

.record-entry-panel .note-toggle {
  padding: 18rpx 22rpx;
}

.note-toggle-title,
.note-toggle-action {
  display: block;
}

.note-toggle-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #4f5f73;
}

.note-toggle-action {
  font-size: 20rpx;
  font-weight: 700;
  color: #90a0b4;
}

.note-editor {
  padding: 0 18rpx 18rpx;
}

.picker-placeholder {
  color: #a0acbb;
}

.scroll-select {
  width: 100%;
  white-space: nowrap;
}

.scroll-track {
  display: inline-flex;
  align-items: stretch;
  padding: 2rpx 4rpx 6rpx;
}

.scroll-track-compact {
  padding-bottom: 2rpx;
}

.segmented-options {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
}

.segmented-options .pill-option {
  margin-right: 0;
}

.readonly-field {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border: 1rpx solid rgba(239, 224, 218, 0.95);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.74);
  font-size: 28rpx;
  font-weight: 700;
  color: #324051;
}

.option-card,
.pill-option {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  border: 1rpx solid rgba(239, 224, 218, 0.95);
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(248, 243, 240, 0.92) 100%);
  box-shadow: 0 10rpx 22rpx rgba(230, 208, 198, 0.14);
  color: #617083;
}

.option-card {
  width: 250rpx;
  min-height: 100rpx;
  padding: 20rpx 22rpx;
}

.option-card-compact {
  width: auto;
  min-width: 136rpx;
  min-height: 70rpx;
  padding: 13rpx 20rpx;
