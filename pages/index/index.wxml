<view class="page {{editingId ? 'page-editing' : ''}}">
  <view class="hero-card">
    <view class="hero-text">
      <text class="hero-title">{{babyProfile.name || '我的宝宝'}}</text>
      <text class="hero-desc">{{ageHeroText}}</text>
    </view>

    <view class="hero-stats">
      <view wx:for="{{heroStats}}" wx:key="label" class="stat-card {{item.cardClass}}">
        <text class="stat-label">{{item.label}}</text>
        <text class="stat-value">{{item.value}}</text>
      </view>
    </view>

    <view class="latest-status-grid">
      <view
        wx:for="{{latestStatusCards}}"
        wx:key="label"
        class="latest-status-card {{item.cardClass}} {{item.toneClass}}"
      >
        <view class="latest-status-head">
          <text class="latest-status-label">{{item.label}}</text>
          <view wx:if="{{item.badgeText}}" class="latest-status-badge {{item.badgeClass}}">
            <text class="latest-status-badge-text">{{item.badgeText}}</text>
          </view>
        </view>
        <text class="latest-status-time">{{item.timeText}}</text>
        <text class="latest-status-summary">{{item.summaryText}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{editingId}}" class="record-popup-mask"></view>

  <view class="record-entry-shell {{editingId ? 'record-entry-shell-popup' : ''}}" bindtap="handlePopupClose">
    <view class="panel record-entry-panel {{editingId ? 'record-entry-panel-popup' : ''}}" catchtap="handlePopupTap">
      <view class="section-head">
        <text class="section-title">{{editingId ? '编辑记录' : '快速记录'}}</text>
        <text wx:if="{{editingId}}" class="section-note">保存后顶部时间会立即同步</text>
      </view>

      <view wx:if="{{editingId}}" class="edit-banner">
        <view class="edit-banner-main">
          <text class="edit-banner-title">正在编辑当前记录</text>
          <text class="edit-banner-desc">{{editingSummaryText}}</text>
        </view>
        <button class="ghost-btn edit-banner-btn" size="mini" bindtap="handleCancelEdit">取消</button>
      </view>

      <view class="field">
        <scroll-view scroll-x class="scroll-select">
          <view class="scroll-track scroll-track-compact">
            <view
              wx:for="{{recordTypes}}"
              wx:key="id"
              class="option-card option-card-compact {{form.type === item.id ? 'option-card-active' : ''}}"
              data-type="{{item.id}}"
              bindtap="handleTypeChange"
            >
              <text class="option-title">{{item.label}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="field-row field-row-compact">
        <view class="field field-compact">
          <text class="field-label field-label-compact">日期</text>
          <picker mode="date" value="{{form.date}}" bindchange="handleDateChange">
            <view class="picker-field picker-field-compact">{{form.date}}</view>
          </picker>
        </view>
        <view class="field field-compact">
          <text class="field-label field-label-compact">时间</text>
          <picker mode="time" value="{{form.time}}" bindchange="handleTimeChange">
            <view class="picker-field picker-field-compact">{{form.time}}</view>
          </picker>
        </view>
      </view>

      <block wx:if="{{form.type === 'feeding'}}">
        <view class="field">
          <text class="field-label">喂养方式</text>
          <scroll-view scroll-x class="scroll-select">
            <view class="scroll-track">
              <view
                wx:for="{{feedingMethods}}"
                wx:key="*this"
                class="pill-option {{form.method === item ? 'pill-option-active' : ''}}"
                data-method="{{item}}"
                bindtap="handleFeedingMethodChange"
              >
                {{item}}
              </view>
            </view>
          </scroll-view>
        </view>
        <view class="field-row">
          <view class="field">
            <text class="field-label">{{form.method === '母乳' ? '时间（分钟）' : '奶量（ml）'}}</text>
            <input
              class="input-field"
              type="number"
              placeholder="{{form.method === '母乳' ? '例如 15' : '例如 120'}}"
              value="{{form.amount}}"
              bindinput="handleAmountInput"
            />
          </view>
          <view class="field">
            <text class="field-label">{{form.method === '母乳' ? '常用时长' : '常用奶量'}}</text>
            <picker
              mode="selector"
              range="{{form.method === '母乳' ? durationOptions : amountOptions}}"
              range-key="label"
              value="{{amountPickerIndex}}"
              bindchange="handleAmountOptionChange"
            >
              <view class="picker-field {{form.amount ? '' : 'picker-placeholder'}}">
                {{form.amount ? form.amount + (form.method === '母乳' ? ' 分钟' : ' ml') : (form.method === '母乳' ? '选择常用时长' : '选择常用奶量')}}
              </view>
            </picker>
          </view>
        </view>
      </block>

      <block wx:if="{{form.type === 'diaper'}}">
        <text class="helper-text diaper-helper-text">以下项目都可选，不填也可以；再次点击已选项可取消。</text>

        <view class="field">
          <text class="field-label">尿布状态（可选）</text>
          <scroll-view scroll-x class="scroll-select">
            <view class="scroll-track">
              <view
                wx:for="{{diaperTypes}}"
                wx:key="*this"
                class="pill-option {{form.diaperType === item ? 'pill-option-active' : ''}}"
                data-diaper-type="{{item}}"
                bindtap="handleDiaperTypeChange"
              >
                {{item}}
              </view>
            </view>
          </scroll-view>
        </view>

        <block wx:if="{{form.diaperType === '便便' || form.diaperType === '混合'}}">
          <view class="field">
            <text class="field-label">便便颜色（可选）</text>
            <view class="poop-grid">
              <view
                wx:for="{{poopColors}}"
                wx:key="id"
                class="poop-card {{form.poopColorId === item.id ? 'poop-card-active' : ''}}"
                data-color-id="{{item.id}}"
                bindtap="handlePoopColorChange"
              >
                <image class="poop-image" src="{{item.image}}" mode="aspectFit" />
                <text class="poop-name">{{item.label}}</text>
              </view>
            </view>
          </view>

          <view class="field">
            <text class="field-label">便便形状（可选）</text>
            <scroll-view scroll-x class="scroll-select">
              <view class="scroll-track">
                <view
                  wx:for="{{poopShapes}}"
                  wx:key="id"
                  class="pill-option pill-option-shape {{form.poopShapeId === item.id ? 'pill-option-active' : ''}}"
                  data-shape-id="{{item.id}}"
                  bindtap="handlePoopShapeChange"
                >
                  {{item.label}}
                </view>
              </view>
            </scroll-view>
          </view>

          <view class="field">
            <text class="field-label">红屁屁（可选）</text>
            <view class="field-row diaper-rash-row">
              <view
                wx:for="{{diaperRashOptions}}"
                wx:key="id"
                class="pill-option diaper-rash-option {{form.diaperRash === item.id ? 'pill-option-active' : ''}}"
                data-rash-id="{{item.id}}"
                bindtap="handleDiaperRashChange"
              >
                {{item.label}}
              </view>
            </view>
          </view>
        </block>
      </block>

      <block wx:if="{{form.type === 'growth'}}">
        <view class="field-row">
          <view class="field">
            <text class="field-label">身高（cm）</text>
            <input
              class="input-field"
              type="digit"
              placeholder="例如 65"
              value="{{form.height}}"
              bindinput="handleHeightInput"
            />
          </view>
          <view class="field">
            <text class="field-label">体重（kg）</text>
            <input
              class="input-field"
              type="digit"
              placeholder="例如 6.8"
              value="{{form.weight}}"
              bindinput="handleWeightInput"
            />
          </view>
        </view>
        <view class="field">
          <text class="field-label">头围（cm）</text>
          <input
            class="input-field"
            type="digit"
            placeholder="例如 41"
            value="{{form.headCircumference}}"
            bindinput="handleHeadCircumferenceInput"
          />
        </view>
      </block>

      <block wx:if="{{form.type === 'sleep'}}">
        <view class="field">
          <text class="field-label">睡眠类型</text>
          <scroll-view scroll-x class="scroll-select">
            <view class="scroll-track">
              <view
                wx:for="{{sleepTypes}}"
                wx:key="*this"
                class="pill-option {{form.sleepType === item ? 'pill-option-active' : ''}}"
                data-sleep-type="{{item}}"
                bindtap="handleSleepTypeChange"
              >
                {{item}}
              </view>
            </view>
          </scroll-view>
        </view>
        <view class="field">
          <text class="field-label">睡眠时长（分钟）</text>
          <input
            class="input-field"
            type="number"
            placeholder="例如 90"
            value="{{form.durationMinutes}}"
            bindinput="handleDurationInput"
          />
        </view>
      </block>

      <block wx:if="{{form.type === 'medicine'}}">
        <view class="field">
          <text class="field-label">药名</text>
          <input
            class="input-field"
            placeholder="例如 维生素D"
            value="{{form.medicineName}}"
            bindinput="handleMedicineNameInput"
          />
        </view>
        <view class="field-row">
          <view class="field">
            <text class="field-label">剂量</text>
            <input
              class="input-field"
              type="digit"
              placeholder="例如 5"
              value="{{form.dosage}}"
              bindinput="handleDosageInput"
            />
          </view>
          <view class="field">
            <text class="field-label">单位</text>
            <scroll-view scroll-x class="scroll-select compact-scroll">
              <view class="scroll-track">
                <view
                  wx:for="{{medicineUnits}}"
                  wx:key="*this"
                  class="pill-option pill-option-compact {{form.doseUnit === item ? 'pill-option-active' : ''}}"
                  data-dose-unit="{{item}}"
                  bindtap="handleDoseUnitChange"
                >
                  {{item}}
                </view>
              </view>
            </scroll-view>
          </view>
        </view>
      </block>

      <block wx:if="{{form.type === 'temperature'}}">
        <view class="field">
          <text class="field-label">体温（℃）</text>
          <input
            class="input-field"
            type="digit"
            placeholder="例如 36.7"
            value="{{form.temperature}}"
            bindinput="handleTemperatureInput"
          />
        </view>
        <view class="field">
          <text class="field-label">测量方式</text>
          <scroll-view scroll-x class="scroll-select">
            <view class="scroll-track">
              <view
                wx:for="{{temperatureMethods}}"
                wx:key="*this"
                class="pill-option {{form.temperatureMethod === item ? 'pill-option-active' : ''}}"
                data-method="{{item}}"
                bindtap="handleTemperatureMethodChange"
              >
                {{item}}
              </view>
            </view>
          </scroll-view>
        </view>
      </block>

      <view class="note-box">
        <view class="note-toggle" bindtap="handleToggleNote">
          <text class="note-toggle-title">备注</text>
          <text class="note-toggle-action">{{noteExpanded ? '收起' : (form.note ? '展开已填写备注' : '选填')}}</text>
        </view>
        <view wx:if="{{noteExpanded}}" class="note-editor">
          <textarea
            class="textarea-field textarea-field-compact"
            placeholder="记录状态、反应或其他说明"
            value="{{form.note}}"
            maxlength="200"
            bindinput="handleNoteInput"
          ></textarea>
        </view>
      </view>

      <button class="primary-btn" bindtap="handleSubmit">
        {{editingId ? '保存修改' : '保存记录'}}
      </button>
    </view>
  </view>

  <view class="panel">
    <view class="section-head">
      <text class="section-title">最近记录</text>
      <view class="records-head-side">
        <text class="section-note">{{listNote}}</text>
        <view
          class="record-filter-trigger {{hasActiveFilter ? 'record-filter-trigger-active' : ''}}"
          bindtap="handleToggleRecordFilter"
        >
          <image class="record-filter-trigger-icon" src="/assets/icons/filter.svg" mode="aspectFit" />
          <view wx:if="{{hasActiveFilter}}" class="record-filter-trigger-dot"></view>
        </view>
      </view>
    </view>

    <view wx:if="{{!filterCollapsed}}" class="record-filter-box">
      <view class="record-filter-box-head">
        <view class="record-filter-box-main">
          <text class="record-filter-box-title">筛选条件</text>
          <text class="record-filter-box-desc">{{filterTip}}</text>
        </view>
        <view class="record-filter-box-side">
          <text wx:if="{{hasActiveFilter}}" class="record-filter-box-tag">已筛选</text>
          <text class="record-filter-box-action" bindtap="handleToggleRecordFilter">收起</text>
        </view>
      </view>

      <view class="record-filter-content">
        <view class="field record-filter-field">
          <text class="field-label">分类</text>
          <scroll-view scroll-x class="scroll-select compact-scroll">
            <view class="scroll-track">
              <view
                wx:for="{{recordFilterOptions}}"
                wx:key="id"
                class="pill-option pill-option-filter {{filterType === item.id ? 'pill-option-active' : ''}}"
                data-type="{{item.id}}"
                bindtap="handleFilterTypeChange"
              >
                {{item.label}}
              </view>
            </view>
          </scroll-view>
        </view>

        <view class="field record-filter-field">
          <text class="field-label">日期</text>
          <picker mode="date" value="{{filterPickerValue}}" bindchange="handleFilterDateChange">
            <view class="picker-field {{filterDate ? '' : 'picker-placeholder'}}">
              {{filterDate || '选择日期筛选历史记录'}}
            </view>
          </picker>
        </view>

        <view class="filter-actions">
          <button
            class="ghost-btn filter-reset-btn"
            size="mini"
            disabled="{{!hasActiveFilter}}"
            bindtap="handleResetFilter"
          >
            重置筛选
          </button>
          <text class="filter-tip">{{filterTip}}</text>
        </view>

        <view wx:if="{{hasActiveFilter}}" class="mini-stats">
          <view wx:for="{{filterStats}}" wx:key="label" class="mini-stat">
            <text class="mini-stat-label">{{item.label}}</text>
            <text class="mini-stat-value">{{item.value}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{!records.length}}" class="empty-state">
      <text class="empty-title">{{emptyTitle}}</text>
      <text class="empty-desc">{{emptyDesc}}</text>
    </view>

    <view wx:for="{{recordGroups}}" wx:key="date" wx:for-item="group" class="record-group">
      <view class="record-group-head">
        <view class="record-group-main">
          <text class="record-group-date">{{group.dateLabel}}</text>
          <text class="record-group-raw-date">{{group.date}}</text>
        </view>
        <view class="record-group-stats">
          <text class="record-group-stat">{{group.feedingSummaryText}}</text>
          <text class="record-group-stat">{{group.diaperSummaryText}}</text>
        </view>
      </view>

      <view wx:for="{{group.records}}" wx:key="id" wx:for-item="item" class="record-card">
        <view class="record-top">
          <view class="record-meta">
            <view class="record-badge {{item.badgeClass}}">{{item.typeLabel}}</view>
            <text class="record-time">{{item.displayTime}}</text>
          </view>
        </view>

        <view class="record-body">
          <view class="record-main">
            <text class="record-title">{{item.title}}</text>
            <text wx:if="{{item.subtitle}}" class="record-subtitle">{{item.subtitle}}</text>
            <text wx:if="{{item.note}}" class="record-note">备注：{{item.note}}</text>
          </view>

          <view class="record-actions">
            <view
              class="record-icon-btn record-icon-edit"
              data-id="{{item.id}}"
              bindtap="handleEdit"
            >
              <image class="record-action-icon" src="/assets/icons/edit.svg" mode="aspectFit" />
            </view>
            <view
              class="record-icon-btn record-icon-delete"
              data-id="{{item.id}}"
              bindtap="handleDelete"
            >
              <image class="record-action-icon" src="/assets/icons/delete.svg" mode="aspectFit" />
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{records.length}}" class="record-list-footer">
      <view wx:if="{{hasMoreRecords}}" class="record-list-footer-action" bindtap="handleLoadMoreRecords">
        <text class="record-list-footer-text">{{isLoadingMoreRecords ? '加载中...' : '下滑继续加载'}}</text>
      </view>
      <text wx:else class="record-list-footer-text record-list-footer-text-muted">已经到底了</text>
    </view>
  </view>
</view>
